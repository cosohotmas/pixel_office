# Ignore Python bytecode generated by local tests.
# 로컬 테스트가 생성하는 Python 바이트코드를 무시합니다.
__pycache__/
*.py[cod]

# Ignore frontend dependencies and build output.
# Frontend 의존성과 빌드 결과를 무시합니다.
node_modules/
dist/

# Keep local environments and test artifacts out of the repository.
# 로컬 환경과 테스트 산출물이 저장소에 들어가지 않게 합니다.
.venv/
.pytest_cache/
.ruff_cache/
test-results/
playwright-report/
.env
.env.*
!.env.example

